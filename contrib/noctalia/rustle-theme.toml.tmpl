# Noctalia template for rustle's overlay palette (rendered to $XDG_CONFIG_HOME/rustle/theme.toml).
# rustle watches the output file and re-reads it as soon as Noctalia rewrites it, so no post_hook is needed.
background = "{{ colors.surface.default.hex }}"
surface = "{{ colors.surface_container_high.default.hex }}"
border = "{{ colors.outline_variant.default.hex }}"
accent = "{{ colors.primary.default.hex }}"
text = "{{ colors.on_surface.default.hex }}"
error = "{{ colors.error.default.hex }}"
